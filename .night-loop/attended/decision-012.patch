diff --git a/test/e2e/gate-attended.test.ts b/test/e2e/gate-attended.test.ts
new file mode 100644
index 0000000..af2953a
--- /dev/null
+++ b/test/e2e/gate-attended.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, test } from "bun:test";
+import { join } from "node:path";
+import { atomicWriteJson, readJsonFile, withFixtureRepo } from "../../src/core";
+
+// Decision 012 attended edits: the gate fails closed on an unreadable payload, reads the armed
+// worker cap from the environment before contract.json, and holds think turns read-only.
+const PRODUCT_ROOT = join(import.meta.dir, "..", "..");
+const GATE_HOOK = join(PRODUCT_ROOT, ".night-loop", "hooks", "gate.ts");
+
+async function gate(root: string, payload: string, env: Record<string, string> = {}) {
+  const child = Bun.spawn([process.execPath, GATE_HOOK], {
+    cwd: root,
+    env: { ...process.env, CLAUDE_PROJECT_DIR: root, NIGHT_LOOP_THINK: "", NIGHT_LOOP_WORKERS: "", ...env },
+    stdin: "pipe",
+    stdout: "pipe",
+    stderr: "pipe",
+  });
+  child.stdin.write(payload);
+  child.stdin.end();
+  const [stdout, exitCode] = await Promise.all([new Response(child.stdout).text(), child.exited]);
+  return { stdout, exitCode, decision: stdout.trim() ? (JSON.parse(stdout) as { hookSpecificOutput: { permissionDecision: string } }).hookSpecificOutput.permissionDecision : "allow" };
+}
+
+describe("attended gate hardening (decision 012)", () => {
+  test("an unparseable payload is denied, not allowed", async () => {
+    await withFixtureRepo("gate unparseable", async (root) => {
+      const result = await gate(root, "{not json");
+      expect(result.exitCode).toBe(0);
+      expect(result.decision).toBe("deny");
+      expect(result.stdout).toContain("could not parse");
+    });
+  });
+
+  test("the armed NIGHT_LOOP_WORKERS wins over a later contract.json", async () => {
+    await withFixtureRepo("gate workers", async (root) => {
+      const agent = JSON.stringify({ tool_name: "Agent", tool_input: { subagent_type: "general-purpose", prompt: "work" } });
+      atomicWriteJson(join(root, ".night-loop", "state", "contract.json"), { limits: { workers: 8 } });
+      expect((await gate(root, agent, { NIGHT_LOOP_WORKERS: "1" })).decision).toBe("deny");
+      atomicWriteJson(join(root, ".night-loop", "state", "contract.json"), { limits: { workers: 1 } });
+      expect((await gate(root, agent, { NIGHT_LOOP_WORKERS: "8" })).decision).toBe("allow");
+      expect((await gate(root, agent, { NIGHT_LOOP_WORKERS: "auto" })).decision).toBe("allow");
+      expect((await gate(root, agent)).decision).toBe("deny");
+    });
+  });
+
+  test("a think turn denies edits but still allows reading and still gates escapes", async () => {
+    await withFixtureRepo("gate think", async (root) => {
+      const write = JSON.stringify({ tool_name: "Write", tool_input: { file_path: "src/a.ts", content: "x" } });
+      const edit = JSON.stringify({ tool_name: "Edit", tool_input: { file_path: "src/a.ts", old_string: "a", new_string: "b" } });
+      const log = JSON.stringify({ tool_name: "Bash", tool_input: { command: "git log --oneline -3" } });
+      const push = JSON.stringify({ tool_name: "Bash", tool_input: { command: "git push origin main" } });
+      expect((await gate(root, write, { NIGHT_LOOP_THINK: "1" })).decision).toBe("deny");
+      expect((await gate(root, edit, { NIGHT_LOOP_THINK: "1" })).decision).toBe("deny");
+      expect((await gate(root, log, { NIGHT_LOOP_THINK: "1" })).decision).toBe("allow");
+      expect((await gate(root, push, { NIGHT_LOOP_THINK: "1" })).decision).toBe("deny");
+      expect((await gate(root, write)).decision).toBe("allow");
+      const tape = await Bun.file(join(root, ".night-loop", "state", "events.jsonl")).text();
+      expect(tape.split('"category":"think_turn_read_only"').length - 1).toBe(2);
+    });
+  });
+
+  test("the plugin hooks fail closed and give the verifier a full-harness timeout", () => {
+    const hooks = readJsonFile<{ hooks: Record<string, Array<{ hooks: Array<Record<string, unknown>> }>> }>(join(PRODUCT_ROOT, "hooks", "hooks.json"));
+    expect(hooks.hooks.PreToolUse![0]!.hooks[0]!.onFailure).toBe("block");
+    expect(hooks.hooks.Stop![0]!.hooks[0]!.timeout).toBe(1800);
+  });
+});
