{
  "name": "night-loop-project",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun run scripts/lint.ts",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e --timeout 30000",
    "test:screenshot": "bun run scripts/test-screenshot.ts",
    "test:flake-baseline": "bun run scripts/flake-baseline.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "perf": "bun run scripts/perf.ts",
    "smoke:live": "bun run scripts/live-smoke.ts",
    "seed": "bun run scripts/seed.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
