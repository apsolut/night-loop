# NIGHT LOOP environment. Copy to .env and fill in. NEVER commit real values.
# .env is gitignored; only this example (no secrets) is tracked.

# --- Claude auth ---
# The flat interactive Max path uses your Claude Code OAuth login (mount ~/.claude into the
# jail); no key is needed there. Only set a key if you use the headless / Agent SDK fallback,
# which is metered separately.
# ANTHROPIC_API_KEY=

# --- Research APIs (optional; intake falls back to WebSearch without them) ---
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=

# --- Optional external decider (model-diverse judge / selector / spec-critic) ---
# DECISION_CLI=ollama run llama3.1

# --- NIGHT LOOP tuning ---
NIGHT_LOOP_MAX_STEPS=2000
NIGHT_LOOP_PERM_MODE=acceptEdits        # use bypassPermissions ONLY inside the Docker jail
NIGHT_LOOP_MAX_RELAUNCH=200
NIGHT_LOOP_STALL_TICKS=80

# --- The project being built supplies its OWN test credentials (never real) ---
# Keep these in the jail only. Examples:
# STRIPE_SECRET_KEY=sk_test_xxx
# DATABASE_URL=file:./dev.db
